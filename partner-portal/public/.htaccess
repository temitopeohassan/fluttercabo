# Apache and LiteSpeed rules for the partner portal.
# Upload the contents of dist/ to the document root of the portal's domain,
# e.g. partners.caboapp.online. This file must be uploaded too (it is hidden).

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Single-page app: any path that is not a real file is served index.html,
    # so links such as /bookings/bk12 open the right page.
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # File names in assets/ change with every build, so they can be cached for a year.
    <FilesMatch "\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # index.html must always be fresh so visitors get the latest build.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
